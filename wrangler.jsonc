{
  "name": "bradyci-site",
  "main": "./worker.js",
  "compatibility_date": "2026-09-26",
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "previews": {},
  "d1_databases": [
    {
      "binding": "brady_agent_memory",
      "database_name": "brady-agent-memory",
      "database_id": "494169c2-80c3-4f8d-8a50-12fd502906d2"
    }
  ]
}
